# =========================================================================
# trust-infisical - variables de entorno (plantilla, sin valores reales)
# Copiar a .env y completar. NUNCA commitear el .env real.
# =========================================================================

# --- Dominio / Traefik ---
# No hay dominio propio: se usa el patrón sslip.io (resuelve a la IP embebida en el subdominio)
# Local:      infisical.127.0.0.1.sslip.io
# VPS (prod): infisical.62-238-26-202.sslip.io  (IP pública 62.238.26.202)
DOMAIN=infisical.62-238-26-202.sslip.io

# --- Infisical core secrets (bootstrap propio, no vienen de Infisical) ---
# Generar con: openssl rand -hex 16  (debe ser exactamente 16 bytes / 32 caracteres hex)
ENCRYPTION_KEY=
# Generar con: openssl rand -base64 32
AUTH_SECRET=
SITE_URL=https://${DOMAIN}

# --- PostgreSQL ---
POSTGRES_USER=infisical
POSTGRES_PASSWORD=
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Puerto interno del backend (no exponer al host directamente) ---
BACKEND_INTERNAL_PORT=8080
# Puerto en el host para el túnel SSH de administración (ajustar si ya está en uso, ej. por Traefik dashboard)
ADMIN_HOST_PORT=9080
# IPs públicas permitidas para acceder a la UI de administración (formato CIDR, separadas por coma)
ADMIN_ALLOWED_IPS=
